# Para rodar no computador com o banco online: copie para ".env" e preencha com
# as chaves do projeto Firebase do Primárias (console.firebase.google.com →
# Configurações do projeto → Seus apps → app da Web → Configuração).
# Sem elas o app abre no modo demonstração, com os dados só no navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# opcional: chave do reCAPTCHA v3 para o App Check (vazia = desligado)
VITE_APPCHECK_SITE_KEY=
